# Copy to .env.local. Never commit real keys.
# mock is the offline demo; real uses Arbitrum One (chainId 42161).
CHAIN_MODE=mock
# Required in real mode; optional in mock. Generate with scripts/setup-demo-auth.mjs.
# Server-only. Never use NEXT_PUBLIC_ for these values.
DEMO_AUTH_PASSWORD_HASH=
DEMO_AUTH_SECRET=
ARBITRUM_RPC_URL=
STREAMS_CONTRACT_ADDRESS=
ARGT_ADDRESS=0x59863989d080B22476DB95656d0C3CC18be92214
# Real mode: address that receives the 0.05% Continuum commission. If empty, deposits
# still work and the fee is recorded as "fee pendiente".
TREASURY_ADDRESS=

# Server-only custodial wallet keys, added when the demo wallets exist.
DEMO_PK_PLATFORM=
DEMO_PK_WORKER1=
DEMO_PK_WORKER2=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by Foundry when verifying the deployed contract.
ARBISCAN_API_KEY=

# Server-only. Enables the worker copilot chat (/api/agent/chat).
ANTHROPIC_API_KEY=
